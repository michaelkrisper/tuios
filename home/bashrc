#
# ~/.bashrc
#

export PATH="$HOME/.local/bin:$PATH"

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# ble.sh: suggestions while typing + syntax highlighting. Load early, attach at the end.
[[ -f ~/.local/share/blesh/ble.sh ]] && source ~/.local/share/blesh/ble.sh --noattach

# --- History ---------------------------------------------------------------
HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend cmdhist

# --- Shell-Optionen --------------------------------------------------------
shopt -s autocd cdspell dirspell globstar checkwinsize no_empty_cmd_completion

export EDITOR=nano
export VISUAL=nano
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export MANROFFOPT="-c"
export BAT_THEME="Catppuccin Mocha"
export LESS="-R --mouse"

[[ -r /usr/share/bash-completion/bash_completion ]] && . /usr/share/bash-completion/bash_completion

# --- fzf (Ctrl-T Dateien, Alt-C Ordner, **<Tab>) ---------------------------
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
export FZF_DEFAULT_OPTS="--height 50% --layout reverse --border rounded --info inline-right \
--color=bg+:#313244,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7 \
--color=pointer:#f5e0dc,marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8,border:#585b70"
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always --line-range :200 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level 2 --icons --color=always {}'"
_fzf_compgen_path() { fd --hidden --exclude .git . "$1"; }
_fzf_compgen_dir() { fd --type d --hidden --exclude .git . "$1"; }
# Under ble.sh use its fzf integration: ble.sh misreads the macros from
# `fzf --bash` (Alt-C) and opens the editor.
if [[ ${BLE_VERSION-} ]]; then
    _ble_contrib_fzf_base=/usr/share/fzf
    ble-import -d integration/fzf-completion
    ble-import -d integration/fzf-key-bindings
else
    eval "$(fzf --bash)"
fi

# --- zoxide: z <teil>, zi = interaktiv ------------------------------------
eval "$(zoxide init bash)"

# --- atuin: Ctrl-R History-Suche (Pfeil-hoch bleibt normal) ----------------
eval "$(atuin init bash --disable-up-arrow)"

# --- Aliase ----------------------------------------------------------------
alias ls='eza --icons --group-directories-first'
alias ll='eza -l --icons --git --group-directories-first --time-style=relative'
alias la='eza -la --icons --git --group-directories-first --time-style=relative'
alias lt='eza --tree --level 2 --icons'
alias cat='bat -pp'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias g='git'
alias gs='git status -sb'
alias gl='git log --oneline --graph --decorate -20'
alias gd='git diff'

# mkdir + cd
mkcd() { mkdir -p -- "$1" && cd -- "$1"; }

# pick a project with fzf and cd into it
p() {
    local d
    d=$(fd --type d --hidden --max-depth 3 '^\.git$' ~ --exec dirname {} \; 2>/dev/null \
        | sort | fzf --preview 'eza --tree --level 1 --icons --color=always {}') && cd "$d"
}

# yazi: on exit, cd into the directory it showed last
y() {
    local tmp cwd
    tmp=$(mktemp -t yazi-cwd.XXXXXX)
    yazi "$@" --cwd-file="$tmp"
    cwd=$(<"$tmp")
    [[ -n $cwd && $cwd != "$PWD" ]] && cd -- "$cwd"
    rm -f -- "$tmp"
}
alias lg='lazygit'
alias ghd='gh dash'

eval "$(direnv hook bash)"

# --- Prompt ----------------------------------------------------------------
eval "$(starship init bash)"

[[ ${BLE_VERSION-} ]] && ble-attach
