# Every window lives on its own workspace; swaybar-status shows them as tabs.
# Brightness via brightnessctl here (no key daemon), no audio.

set $mod Mod4
# One foot server for all windows: fonts and glyph cache only once.
set $term footclient
set $browser google-chrome-stable --ozone-platform-hint=auto

workspace_layout tabbed
default_border pixel 1
hide_edge_borders --i3 smart
font pango:CaskaydiaMono NF 8
swaybg_command -
focus_follows_mouse no
output eDP-1 scale 2

input type:keyboard {
    xkb_layout de
    xkb_variant mac
}
input type:touchpad {
    tap enabled
    tap_button_map lrm
    natural_scroll enabled
    dwt enabled
}

# Switch tabs: tick to swaybar-status (it manages the workspaces).
bindsym Mod1+Tab       exec swaymsg -q -t send_tick next
bindsym Mod1+Shift+Tab exec swaymsg -q -t send_tick prev
bindsym $mod+Tab       exec swaymsg -q -t send_tick next
bindsym $mod+Shift+Tab exec swaymsg -q -t send_tick prev
bindsym $mod+Left      focus left
bindsym $mod+Right     focus right
bindsym $mod+Return    exec $term
bindsym $mod+c         exec $term bash -lc 'claude; exec bash -l'
bindsym $mod+b         exec $browser
bindsym $mod+q         kill
bindsym $mod+f         fullscreen toggle
bindsym $mod+Shift+c   reload
bindsym $mod+Shift+e   exec swaymsg exit
# Ctrl+Fn+F3: tabs <-> tiles (swaybar-status handles the "split" tick).
bindsym Control+F3     exec swaymsg -t send_tick split

# Brightness: F1/F2 display, F5/F6 keyboard. -e = exponential, fine steps at the low end.
bindsym --locked XF86MonBrightnessDown exec brightnessctl -q -e -n1 -d intel_backlight set 5%-
bindsym --locked XF86MonBrightnessUp   exec brightnessctl -q -e -d intel_backlight set 5%+
bindsym --locked XF86KbdBrightnessDown exec brightnessctl -q -d smc::kbd_backlight set 10%-
bindsym --locked XF86KbdBrightnessUp   exec brightnessctl -q -d smc::kbd_backlight set 10%+

#                       border  backgr.   text    indicator child_border
client.focused          #89b4fa #89b4fa   #1e1e2e #89b4fa   #89b4fa
client.focused_inactive #181825 #181825   #cdd6f4 #45475a   #45475a
client.unfocused        #181825 #181825   #a6adc8 #45475a   #45475a

bar {
    font pango:CaskaydiaMono NFP 10
    height 24
    position bottom
    status_command ~/.local/bin/swaybar-status --loop 5 --cols 160
    pango_markup enabled
    strip_workspace_numbers yes
    binding_mode_indicator no
    tray_output none
    colors {
        background #11111b
        statusline #cdd6f4
        #                  border  backgr.   text
        focused_workspace  #89b4fa #89b4fa   #1e1e2e
        active_workspace   #11111b #11111b   #cdd6f4
        inactive_workspace #11111b #11111b   #a6adc8
        urgent_workspace   #f38ba8 #f38ba8   #1e1e2e
    }
}

# Start: foot server, then one window running Claude Code.
exec foot --server
exec sh -c 'until [ -S "$XDG_RUNTIME_DIR/foot-$WAYLAND_DISPLAY.sock" ]; do sleep 0.05; done; exec footclient bash -lc "claude; exec bash -l"'
